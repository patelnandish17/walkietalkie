# ============================================================================
# SQUAWK WALKIE-TALKIE ENVIRONMENT CONFIGURATION
# ============================================================================

# --- Supabase Configuration (Database, Auth, Storage, Realtime) ---
# Found in Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."

# --- LiveKit WebRTC Configuration (Live Push-to-Talk Rooms) ---
# Found in LiveKit Cloud Console Settings -> Keys
# Fallback to MediaRecorder clip mode if LiveKit is not configured.
VITE_LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="APIMyLiveKitApiKey"
LIVEKIT_API_SECRET="sec_myLiveKitApiSecret"

# --- Web Push (VAPID) for iOS PWA Background Notifications (Optional) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BEl62i..."
VAPID_PRIVATE_KEY="my_vapid_private_key"
VAPID_SUBJECT="mailto:support@squawk.radio"

# --- Deployment URL ---
APP_URL="https://your-squawk-app.vercel.app"
